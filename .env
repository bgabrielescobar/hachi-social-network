; Database driver: "mysql" for the hosted site, "sqlite" to run it locally without installing MySQL
DB_DRIVER=mysql

; MySQL connection
HOST=
DB_NAME=
USER_NAME=
PASSWORD=

; SQLite database file, only used when DB_DRIVER=sqlite
DB_PATH=database/hachi.sqlite

; Show PHP errors on the page (set to 1 only while developing)
APP_DEBUG=0
