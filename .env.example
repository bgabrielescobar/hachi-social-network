; Configuración de la aplicación. Copia este archivo como ".env" y completa los valores.
; El .env no se sube a git (está en .gitignore) porque puede tener contraseñas.
; Las líneas que empiezan con ";" son comentarios.

; Base de datos: "mysql" para el sitio publicado, "sqlite" para programar en tu computadora
; sin instalar MySQL.
DB_DRIVER=mysql

; Conexión a MySQL (solo con DB_DRIVER=mysql)
HOST=
DB_NAME=
USER_NAME=
PASSWORD=

; Archivo de SQLite (solo con DB_DRIVER=sqlite). Se crea solo.
DB_PATH=database/hachi.sqlite

; 1 muestra los errores de PHP en la página (útil al programar). En el sitio publicado déjalo en 0.
APP_DEBUG=0
